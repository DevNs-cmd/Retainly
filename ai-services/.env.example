# Application
APP_NAME=Retainly AI Services
APP_VERSION=0.1.0
DEBUG=false

# API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Service-to-service authentication. Keep false for local development.
# In production, set REQUIRE_API_KEY=true and use a long random API_KEY.
REQUIRE_API_KEY=false
API_KEY=

# Model
CHURN_MODEL_PATH=trained_models/churn_model.pkl
MODEL_THRESHOLD=0.5

# Storage
DATABASE_URL=sqlite:///./retainly.db

# Email (leave SMTP_HOST blank to simulate email delivery locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional external services
OPENAI_API_KEY=
SENDGRID_API_KEY=

# Features
ENABLE_EXPLANATIONS=true
ENABLE_RECOMMENDATIONS=true
