# ============================================================
# Retainly API — environment variables
# Run commands from apps/api/. Never commit real credentials.
# Copy to .env and fill in values for your environment.
# ============================================================

# ------------------------------------
# Application
# ------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------
# Database
# ------------------------------------
DATABASE_URL=postgresql://retainly:retainly@localhost:5432/retainly

# ------------------------------------
# Redis
# ------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------
# CORS
# ------------------------------------
CORS_ORIGINS=http://localhost:3001

# ------------------------------------
# Auth — Clerk (default)
# Set AUTH_PROVIDER=auth0 and update
# issuer/audience/claim keys for Auth0.
# ------------------------------------
AUTH_PROVIDER=clerk
AUTH_ISSUER=https://your-tenant.clerk.accounts.dev
AUTH_AUDIENCE=retainly
AUTH_ORG_CLAIM=org_id
AUTH_ROLE_CLAIM=org_role

# ------------------------------------
# Stripe — billing
# ------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# JSON map of PlanTier → Stripe price ID
# e.g. {"STARTER":"price_xxx","GROWTH":"price_yyy","PRO":"price_zzz","AGENCY":"price_www"}
STRIPE_PRICE_IDS_JSON={}

# Stripe webhook — org-scoped inbound (used before IntegrationConnection exists)
STRIPE_WEBHOOK_ORGANIZATION_ID=
STRIPE_WEBHOOK_SECRET=

# Billing portal redirect URLs
BILLING_SUCCESS_URL=http://localhost:3001/billing/success
BILLING_CANCEL_URL=http://localhost:3001/billing/cancel
BILLING_RETURN_URL=http://localhost:3001/billing

# ------------------------------------
# Plan limits (optional override)
# JSON map of PlanTier → { students, courses, emails }
# Defaults are defined in plan-policy.ts
# ------------------------------------
PLAN_LIMITS_JSON={}

# ------------------------------------
# Integrations — encryption
# 32-byte key, base64-encoded (openssl rand -base64 32)
# ------------------------------------
INTEGRATION_ENCRYPTION_KEY=

# ------------------------------------
# Webhooks — routing token HMAC key
# At least 32 random characters
# ------------------------------------
WEBHOOK_ROUTING_KEY=

# ------------------------------------
# Public API URL — used to generate
# per-provider webhook endpoint URLs
# ------------------------------------
PUBLIC_API_URL=http://localhost:3000

# ------------------------------------
# Provider bridges
# JSON map of provider → { baseUrl, token }
# Used for providers without direct SDK support
# e.g. {"podia":{"baseUrl":"https://bridge.example.com","token":"..."}}
# ------------------------------------
PROVIDER_BRIDGES_JSON={}

# ------------------------------------
# Automation — outbound webhook endpoints
# JSON map of endpointKey → { url, token }
# e.g. {"my-crm":{"url":"https://crm.example.com/hook","token":"..."}}
# ------------------------------------
AUTOMATION_WEBHOOK_ENDPOINTS_JSON={}

# ------------------------------------
# AWS — S3 student CSV imports
# ------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
IMPORT_BUCKET=retainly-imports

# ------------------------------------
# Risk scoring — AI team HTTP adapter
# Leave blank to trigger ServiceUnavailableException
# (safe for local dev without the AI service running)
# ------------------------------------
RISK_SCORING_URL=
RISK_SCORING_TOKEN=

# ------------------------------------
# Risk tier thresholds (optional)
# Defaults: high=0.7, medium=0.4, champion=0.1
# ------------------------------------
RISK_HIGH_THRESHOLD=0.7
RISK_MEDIUM_THRESHOLD=0.4
RISK_CHAMPION_THRESHOLD=0.1
