datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
  AGENCY
}

enum Role {
  OWNER
  ADMIN
  COACH
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum Segment {
  HIGH_RISK
  MEDIUM_RISK
  LOW_RISK
  CHAMPION
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
  EXPIRED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SNOOZED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
}

enum Channel {
  EMAIL
  SMS
  MIXED
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Organization {
  id               String    @id @default(uuid())
  name             String
  logo             String?
  timezone         String    @default("UTC")
  planTier         PlanTier  @default(STARTER) @map("plan_tier")
  stripeCustomerId String?   @map("stripe_customer_id")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  email          String
  avatar         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Membership {
  id               String          @id @default(uuid())
  organizationId   String          @map("organization_id")
  userId           String?         @map("user_id")
  role             Role
  invitationEmail  String?         @map("invitation_email")
  invitationStatus String          @default("PENDING") @map("invitation_status")
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([organizationId, invitationEmail])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

model Student {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  name            String
  email           String
  phone           String?
  provider        String?
  externalId      String?   @map("external_id")
  assignedCoachId String?   @map("assigned_coach_id")
  segment         Segment?
  riskScore       Float?    @map("risk_score")
  emailOptOut     Boolean   @default(false) @map("email_opt_out")
  reviewedAt      DateTime? @map("reviewed_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, email])
  @@unique([organizationId, provider, externalId])
  @@index([organizationId, segment])
  @@index([organizationId, deletedAt])
  @@map("students")
}

model Course {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  name                  String
  description           String?
  provider              String?
  externalId            String?   @map("external_id")
  integrationConnectionId String? @map("integration_connection_id")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, deletedAt])
  @@map("courses")
}

model Enrollment {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  studentId        String           @map("student_id")
  courseId         String           @map("course_id")
  status           EnrollmentStatus @default(ACTIVE)
  completionPercent Float           @default(0) @map("completion_percent")
  externalId       String?          @map("external_id")
  provider         String?
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, studentId])
  @@index([organizationId, courseId])
  @@index([organizationId, status])
  @@map("enrollments")
}

model StudentActivity {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  studentId      String   @map("student_id")
  activityType   String   @map("activity_type")
  source         String
  payload        Json
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, studentId])
  @@index([organizationId, occurredAt])
  @@map("student_activities")
}

// ---------------------------------------------------------------------------
// Risk
// ---------------------------------------------------------------------------

model RiskSnapshot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  studentId      String   @map("student_id")
  score          Float
  reasons        Json     // String[]
  confidence     Float
  segment        Segment
  sourceEventId  String   @map("source_event_id")
  calculatedAt   DateTime @map("calculated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, sourceEventId])
  @@index([organizationId, studentId, calculatedAt])
  @@map("risk_snapshots")
}

// ---------------------------------------------------------------------------
// Automation
// ---------------------------------------------------------------------------

model AutomationRule {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  trigger        Json      // { type, conditions }
  actions        Json      // Action[]
  cooldownHours  Int       @default(24) @map("cooldown_hours")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, isActive])
  @@map("automation_rules")
}

model AutomationExecution {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  ruleId         String   @map("rule_id")
  studentId      String   @map("student_id")
  sourceEventId  String   @map("source_event_id")
  status         String
  executedAt     DateTime @map("executed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, ruleId, sourceEventId])
  @@index([organizationId, ruleId, studentId, executedAt])
  @@map("automation_executions")
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  name             String
  type             Channel
  status           CampaignStatus @default(DRAFT)
  segment          Segment?
  templateId       String         @map("template_id")
  message          String?
  scheduledAt      DateTime?      @map("scheduled_at")
  archivedAt       DateTime?      @map("archived_at")
  dispatchCompleted Boolean       @default(false) @map("dispatch_completed")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  campaignId     String    @map("campaign_id")
  studentId      String    @map("student_id")
  channel        String
  status         String    @default("PENDING")
  sentAt         DateTime? @map("sent_at")
  openedAt       DateTime? @map("opened_at")
  convertedAt    DateTime? @map("converted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, campaignId, studentId, channel])
  @@index([organizationId, campaignId])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  title          String
  message        String
  readAt         DateTime? @map("read_at")
  dismissedAt    DateTime? @map("dismissed_at")
  sourceEventId  String    @map("source_event_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, userId, dismissedAt])
  @@map("notifications")
}

model NotificationLog {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  channel          String
  recipient        String
  templateId       String?   @map("template_id")
  status           String    @default("PENDING")
  sourceEventId    String    @map("source_event_id")
  providerMessageId String?  @map("provider_message_id")
  attemptCount     Int       @default(0) @map("attempt_count")
  errorCode        String?   @map("error_code")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, sourceEventId])
  @@index([organizationId, status])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model IntegrationConnection {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  provider             String
  status               String    @default("DISCONNECTED")
  encryptedCredentials String    @map("encrypted_credentials")
  config               Json      @default("{}")
  lastSyncedAt         DateTime? @map("last_synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, provider])
  @@index([organizationId, status])
  @@map("integration_connections")
}

// ---------------------------------------------------------------------------
// Billing & subscriptions
// ---------------------------------------------------------------------------

model Subscription {
  id                 String           @id @default(uuid())
  organizationId     String           @map("organization_id")
  studentId          String           @map("student_id")
  provider           String
  externalId         String           @map("external_id")
  status             EnrollmentStatus
  amountMinor        Int              @map("amount_minor")
  currency           String           @default("USD")
  currentPeriodStart DateTime         @map("current_period_start")
  currentPeriodEnd   DateTime         @map("current_period_end")
  cancelledAt        DateTime?        @map("cancelled_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, studentId])
  @@map("subscriptions")
}

model Payment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  studentId      String   @map("student_id")
  provider       String
  externalId     String   @map("external_id")
  amountMinor    Int      @map("amount_minor")
  currency       String   @default("USD")
  status         String
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, studentId])
  @@map("payments")
}

model BillingSubscription {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  stripeSubscriptionId String    @map("stripe_subscription_id")
  stripeCustomerId     String    @map("stripe_customer_id")
  status               String
  planTier             PlanTier  @map("plan_tier")
  currentPeriodEnd     DateTime  @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, stripeSubscriptionId])
  @@index([organizationId])
  @@map("billing_subscriptions")
}

model Usage {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  metric         String
  periodStart    DateTime @map("period_start")
  quantity       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric])
  @@map("usage")
}

// ---------------------------------------------------------------------------
// Coach tasks
// ---------------------------------------------------------------------------

model CoachTask {
  id               String     @id @default(uuid())
  organizationId   String     @map("organization_id")
  studentId        String     @map("student_id")
  coachId          String     @map("coach_id")
  automationRuleId String?    @map("automation_rule_id")
  title            String
  notes            String?
  status           TaskStatus @default(PENDING)
  dueDate          DateTime?  @map("due_date")
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([organizationId, coachId, status])
  @@index([organizationId, studentId])
  @@map("coach_tasks")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  diff           Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Analytics aggregates
// ---------------------------------------------------------------------------

model AnalyticsAggregate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  kind           String   // "overview" | "cohorts" | "risk-trends" | "campaigns" | "courses" | "activity-daily"
  key            String   // entity ID or dimension key within the kind
  period         DateTime // day-level granularity (truncated to 00:00:00 UTC)
  data           Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, kind, key, period])
  @@index([organizationId, kind, period])
  @@map("analytics_aggregates")
}

// ---------------------------------------------------------------------------
// Outbox (transactional event delivery)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  error          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

model ConsumerReceipt {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  consumer       String
  eventId        String   @map("event_id")
  completedAt    DateTime @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, consumer, eventId])
  @@index([organizationId, consumer])
  @@map("consumer_receipts")
}
