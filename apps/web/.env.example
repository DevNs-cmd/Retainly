# Retainly Web Frontend Environment Variables

# Backend NestJS REST API Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# AI Microservice URL (if direct client access is needed)
NEXT_PUBLIC_AI_SERVICES_URL=http://localhost:8000

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock Data Fallback Toggle (set to 'false' for live API, 'true' to use local mock fixtures)
NEXT_PUBLIC_ENABLE_MOCK=false

# Authentication Provider Configuration (custom | clerk | auth0)
NEXT_PUBLIC_AUTH_PROVIDER=custom
