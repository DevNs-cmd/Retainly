# Retainly Monorepo Environment Variables
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://retainly_user:retainly_password@localhost:5432/retainly_db?schema=public"

# Redis & Queue Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication (Clerk / Auth0 Abstraction)
AUTH_PROVIDER="clerk"
AUTH_SECRET="your-auth-secret-here"
AUTH_ISSUER_URL="https://your-tenant.clerk.accounts.dev"

# Storage
S3_BUCKET="retainly-assets"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

# Integrations Secrets (Placeholders)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
