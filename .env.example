# ============================================================
# Retainly Monorepo — Environment Variables Template
# ============================================================

PORT=3000
NODE_ENV=development

# ------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------
DATABASE_URL="postgresql://retainly_user:retainly_password@localhost:5432/retainly_db?schema=public"

# ------------------------------------
# Redis & Queue Configuration
# ------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------
# Authentication (Clerk / Auth0 / Dev JWT)
# ------------------------------------
AUTH_PROVIDER="clerk"
AUTH_ISSUER="https://your-tenant.clerk.accounts.dev"
AUTH_AUDIENCE="retainly"
AUTH_ORG_CLAIM="org_id"
AUTH_ROLE_CLAIM="org_role"
DEV_AUTH_SECRET="dev-integration-secret-retainly-local-32chars"

# ------------------------------------
# Stripe & Billing Configuration
# Extensible pricing and plans configuration
# ------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_MODE="test"
STRIPE_DEFAULT_CURRENCY="usd"
STRIPE_SUPPORTED_INTERVALS="month,year"
# Map PlanTier enum to Stripe Price IDs
STRIPE_PRICE_IDS_JSON='{"STARTER":"price_starter_test","GROWTH":"price_growth_test","PRO":"price_pro_test","ENTERPRISE":"price_enterprise_test"}'
# Extensible plans catalog schema for dynamic self-serve pricing
STRIPE_PLANS_JSON='[{"id":"STARTER","name":"Starter","price":49,"currency":"usd","interval":"month"},{"id":"GROWTH","name":"Growth","price":99,"currency":"usd","interval":"month"},{"id":"PRO","name":"Pro","price":199,"currency":"usd","interval":"month"},{"id":"ENTERPRISE","name":"Enterprise","price":499,"currency":"usd","interval":"month"}]'
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_WEBHOOK_ORGANIZATION_ID=""

# Billing portal redirect URLs
BILLING_SUCCESS_URL="http://localhost:3001/billing/success"
BILLING_CANCEL_URL="http://localhost:3001/billing/cancel"
BILLING_RETURN_URL="http://localhost:3001/billing"

# ------------------------------------
# Plan Limits (Overrides)
# ------------------------------------
PLAN_LIMITS_JSON='{}'

# ------------------------------------
# Security & Encryption Keys
# ------------------------------------
INTEGRATION_ENCRYPTION_KEY="QgECQ1bi0TL+QFOZhGiPMYmGyusTVTsQdhQ38h5YEcI="
WEBHOOK_ROUTING_KEY="26d2e22f9db065a066efdd62b2737efefbe9db7fdfed7b4b4aef3044a129a63d"
PUBLIC_API_URL="http://localhost:3000"

# ------------------------------------
# Storage & Imports (AWS S3)
# ------------------------------------
S3_BUCKET="retainly-assets"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
IMPORT_BUCKET="retainly-imports"
